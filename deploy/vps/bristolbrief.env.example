# Copy to /etc/bristolbrief.env (chmod 640, root:bristolbrief) and fill in the
# values from the Vercel project. `vercel env pull --environment=production`
# writes them all to a local file you can copy from.
SITE_URL=https://bristolbrief.com
ADMIN_PASSWORD=
ADMIN_GITHUB_TOKEN=
# ADMIN_SESSION_SECRET=
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
