---
import { electionWindow } from '../lib/electionWindow';

// Site-wide banner just below the main menu, from a week before the election until a week after.
// The wording follows the clock (the site rebuilds on every ingest): before, on, and after Election Day.
const { days, live, show } = electionWindow();
const title = live
  ? 'Election results'
  : days > 1
    ? 'Election Day is Tuesday, Nov. 3'
    : days === 1
      ? 'Election Day is tomorrow, Nov. 3'
      : days === 0
        ? 'Election Day: polls close at 8 p.m.'
        : 'Election results';
const text = live
  ? 'Unofficial Bristol County results and the nine ballot questions, updated every 30 minutes.'
  : days >= 0
    ? 'Polling places, who is on the ballot in Bristol County and the nine statewide questions.'
    : 'Election-night counts come from towns and news reports; state results post here when published.';
---
{show && (
  <a class="election-banner" href="/election/" role="region" aria-label="Election Day">
    <span class="wrap eb-inner">
      <strong>{title}</strong>
      <span class="eb-text">{text}</span>
      <span class="eb-go">Open the Election Day page ›</span>
    </span>
  </a>
)}

<style>
  .election-banner { display: block; background: var(--navy); color: #fff; font-family: var(--sans); text-decoration: none; border-bottom: 3px solid var(--accent); }
  .election-banner:hover { background: #0f2540; color: #fff; }
  .eb-inner { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 14px; padding-top: 10px; padding-bottom: 10px; }
  .election-banner strong { font-family: var(--serif-display); font-size: 19px; }
  .eb-text { font-size: 14px; opacity: .9; }
  .eb-go { margin-left: auto; font-size: 14px; font-weight: 700; }
  @media (max-width: 640px) { .eb-go { margin-left: 0; } }
</style>
