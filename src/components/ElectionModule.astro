---
import RaceTracker from './RaceTracker.astro';
import election from '../data/election.json';
import resultsData from '../data/election-results.json';
import { electionWindow } from '../lib/electionWindow';

// Election night tracker for the home page: live market odds for the federal races, plus the state's
// count for the statewide races and ballot questions once results start. Hidden outside the election window.
const { show, live } = electionWindow();
const results = (resultsData as { updated?: string | null; races?: Record<string, any> }).races ?? {};
const updated = (resultsData as { updated?: string | null }).updated;
const when = updated ? new Date(updated).toLocaleTimeString('en-US', { timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit' }) + ' ET' : '';
const pct = (v: number | null | undefined) => (v != null ? `${v}%` : '');
const top = (r: any) => (r.candidates ?? []).slice(0, 2).map((c: any) => `${String(c.name).split(' ').slice(-1)[0]} ${pct(c.pct)}`).join(' · ');
const statewide = election.races.filter((r) => ['governor', 'attorney-general', 'secretary', 'treasurer', 'auditor'].includes(r.key) && results[r.key]);
const questions = election.questions.filter((x) => results[`q${x.n}`]);
const name = (r: { office: string }) => r.office.replace('Governor and Lieutenant Governor', 'Governor').replace('Secretary of the Commonwealth', 'Secretary of State');
---
{show && (
  <section class="etm" aria-label="Election night tracker">
    <div class="wrap">
      <div class="etm-head">
        <h2>Election night tracker</h2>
        <a href="/election/">Full results, polling places and ballot ›</a>
      </div>
      <RaceTracker />
      {live ? (
        <div class="etm-count">
          <p class="etm-title">State count{when && <span> · checked {when}</span>}</p>
          <ul>
            {statewide.map((r) => (<li><span>{name(r)}</span><span>{top(results[r.key])}</span></li>))}
            {questions.slice(0, 9).map((x) => (<li><span>Question {x.n}</span><span>{top(results[`q${x.n}`])}</span></li>))}
          </ul>
        </div>
      ) : (
        <p class="etm-wait">The state's count appears here after the polls close at 8 p.m. and refreshes every 30 minutes. Unofficial results.</p>
      )}
    </div>
  </section>
)}

<style>
  .etm { border-bottom: 1px solid var(--rule); background: var(--paper); padding: 14px 0 12px; }
  .etm-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; }
  .etm h2 { margin: 0; font-family: var(--serif-display); font-size: 24px; }
  .etm-head a { font-family: var(--sans); font-size: 14px; font-weight: 700; }
  .etm-wait { font-family: var(--sans); font-size: 13px; color: var(--ink-2); margin: 4px 0 0; }
  .etm-count { font-family: var(--sans); margin-top: 4px; }
  .etm-title { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); margin: 0 0 4px; }
  .etm-count ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0 24px; }
  .etm-count li { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; border-bottom: 1px solid var(--rule); font-size: 13px; }
  .etm-count li span:last-child { color: var(--ink-2); font-variant-numeric: tabular-nums; text-align: right; }
</style>
