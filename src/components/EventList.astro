---
import type { Event } from '../lib/content';
import { townName } from '../site.config';

interface Props {
  events: Event[];
  compact?: boolean;
}
const { events, compact = false } = Astro.props;
const mon = (d: Date) => d.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short' });
const day = (d: Date) => d.toLocaleDateString('en-US', { timeZone: 'UTC', day: 'numeric' });
const dow = (d: Date) => d.toLocaleDateString('en-US', { timeZone: 'UTC', weekday: 'short' });
---
{events.length === 0 ? (
  <p class="meta">No upcoming events yet. <a href="/tips/">Tell us about one.</a></p>
) : (
  <ol class={`events ${compact ? 'events-compact' : ''}`}>
    {events.map((e) => (
      <li class="event">
        <div class="event-date" aria-hidden="true">
          <span class="event-mon">{mon(e.data.date)}</span>
          <span class="event-day">{day(e.data.date)}</span>
          <span class="event-dow">{dow(e.data.date)}</span>
        </div>
        <div>
          <h3 class="event-title">
            {e.data.url ? <a href={e.data.url}>{e.data.title}</a> : e.data.title}
            {e.data.sample && <span class="sample-tag">Sample</span>}
          </h3>
          <p class="meta">
            <span class="visually-hidden">{e.data.date.toDateString()}, </span>
            {e.data.time && <>{e.data.time} · </>}
            {e.data.venue}, {townName(e.data.town)}
            {e.data.cost && <> · {e.data.cost}</>}
          </p>
          {!compact && e.body && <p class="event-desc">{e.body.trim()}</p>}
        </div>
      </li>
    ))}
  </ol>
)}

<style>
  .events { list-style: none; margin: 0; padding: 0; }
  .event {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .event:first-child { padding-top: 0; }
  .event-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--sans);
    border: 1px solid var(--rule);
    border-top: 4px solid var(--accent);
    padding: 4px 0 6px;
    line-height: 1.1;
    height: fit-content;
  }
  .event-mon, .event-dow { font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--ink-2); }
  .event-day { font-family: var(--serif-display); font-size: 24px; font-weight: 700; }
  .event-title {
    font-family: var(--serif-display);
    font-size: 19px;
    line-height: 1.2;
    margin: 0 0 4px;
  }
  .event-title a { color: var(--ink); text-decoration: none; }
  .event-title a:hover { color: var(--accent); }
  .event .meta { margin: 0; }
  .event-desc { margin: 6px 0 0; font-size: 16px; color: var(--ink-2); }
  .events-compact .event-title { font-size: 17px; }
</style>
