---
import { SITE, SECTIONS, TOWNS } from '../site.config';
import { todayLine } from '../lib/content';

const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar-inner">
      <span class="today" data-today>{todayLine()}</span>
      <nav class="topbar-links" aria-label="Utility">
        <a href="/events/">Events</a>
        <a href="/tips/">Send a tip</a>
        <a href="/about/">About</a>
        <a class="btn btn-sm" href="/subscribe/">Subscribe</a>
      </nav>
    </div>
  </div>

  <div class="wrap masthead">
    <a href="/" class="logo" aria-label={`${SITE.name} home`}>
      <span class="logo-the">The</span>
      <span class="logo-name">Bristol Brief</span>
    </a>
    <p class="masthead-tag">{SITE.tagline}</p>
  </div>

  <nav class="sections" aria-label="Sections">
    <div class="wrap sections-inner">
      <ul>
        {SECTIONS.map((s) => (
          <li>
            <a
              href={`/section/${s.slug}/`}
              aria-current={path.startsWith(`/section/${s.slug}`) ? 'page' : undefined}
            >
              {s.name}
            </a>
          </li>
        ))}
      </ul>
      <details class="towns">
        <summary>Towns</summary>
        <ul class="towns-menu">
          {TOWNS.map((t) => (
            <li><a href={`/towns/${t.slug}/`}>{t.name}</a></li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  // The site is static, so refresh the build-time date in the visitor's browser.
  const el = document.querySelector('[data-today]');
  if (el) {
    el.textContent = new Date().toLocaleDateString('en-US', {
      timeZone: 'America/New_York',
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    });
  }
</script>

<style>
  .topbar {
    background: var(--navy);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 13px;
  }
  @media (prefers-color-scheme: dark) {
    .topbar { background: #0b0e12; color: var(--ink); }
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
  }
  .topbar a { color: inherit; text-decoration: none; }
  .topbar a:hover { text-decoration: underline; }
  .topbar-links { display: flex; align-items: center; gap: 16px; }
  .topbar .btn-sm { padding: 6px 12px; font-size: 13px; color: var(--accent-ink); }
  .topbar .btn-sm:hover { text-decoration: none; }
  @media (max-width: 640px) {
    .today { display: none; }
    .topbar-inner { justify-content: flex-end; }
    .topbar-links { gap: 12px; }
    .topbar-links a:nth-child(3) { display: none; }
  }

  .masthead {
    text-align: center;
    padding: 28px var(--gutter) 18px;
  }
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
  }
  .logo-the {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .logo-name {
    font-family: var(--serif-display);
    font-weight: 800;
    font-size: clamp(40px, 9vw, 76px);
    letter-spacing: -0.02em;
  }
  .masthead-tag {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink-2);
    margin: 10px 0 0;
  }

  .sections {
    border-top: 1px solid var(--rule);
    border-bottom: 3px double var(--ink);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
  }
  .sections-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
  }
  .sections ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sections-inner > ul {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1;
    min-width: 0;
    padding: 12px 0;
  }
  .sections-inner > ul::-webkit-scrollbar { display: none; }
  .sections a {
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .sections a:hover, .sections a[aria-current='page'] { color: var(--accent); }

  .towns { flex: none; }
  .towns summary {
    cursor: pointer;
    list-style: none;
    padding: 6px 10px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    white-space: nowrap;
  }
  .towns summary::-webkit-details-marker { display: none; }
  .towns summary::after { content: ' ▾'; font-size: 11px; }
  .towns[open] summary { border-color: var(--ink); }
  .towns-menu {
    position: absolute;
    right: var(--gutter);
    top: calc(100% + 3px);
    z-index: 10;
    background: var(--paper);
    border: 1px solid var(--rule);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
    padding: 12px 16px !important;
    display: grid;
    grid-template-columns: repeat(2, minmax(140px, 1fr));
    gap: 4px 20px;
    width: min(420px, calc(100vw - 2 * var(--gutter)));
  }
  .towns-menu a { display: block; padding: 4px 0; font-weight: 500; }
</style>
