---
interface Props {
  variant?: 'box' | 'banner';
}
const { variant = 'box' } = Astro.props;
---
<section class={`signup signup-${variant}`} aria-labelledby={`signup-${variant}-title`}>
  <p class="kicker">Free newsletter</p>
  <h2 id={`signup-${variant}-title`}>Bristol County in your inbox</h2>
  <p class="signup-copy">
    The day's headlines from New Bedford to Attleboro, plus upcoming public meetings,
    in one weekday-morning email.
  </p>
  <form class="signup-form" method="post" action="/api/subscribe">
    <label class="visually-hidden" for={`email-${variant}`}>Email address</label>
    <input
      id={`email-${variant}`}
      type="email"
      name="email"
      placeholder="you@example.com"
      autocomplete="email"
      required
    />
    <!-- Left empty by people; bots fill it in. -->
    <input class="visually-hidden" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button class="btn" type="submit">Subscribe</button>
  </form>
  <p class="signup-status meta" role="status" hidden></p>
</section>

<script>
  const MESSAGES: Record<string, string> = {
    ok: 'Thanks! Check your inbox to confirm your subscription.',
    invalid: 'That email address doesn’t look right. Please check it and try again.',
    'not-configured': 'Sign-ups open very soon. Please try again later today.',
    upstream: 'Something went wrong on our end. Please try again in a minute.',
  };
  document.querySelectorAll<HTMLFormElement>('.signup-form').forEach((form) => {
    const status = form.nextElementSibling as HTMLElement;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      button.disabled = true;
      status.hidden = true;
      let result = 'upstream';
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: data.get('email'), website: data.get('website') }),
        });
        const body = await res.json().catch(() => ({}));
        result = body.ok ? 'ok' : body.error ?? 'upstream';
      } catch {}
      status.hidden = false;
      status.textContent = MESSAGES[result] ?? MESSAGES.upstream;
      status.dataset.state = result === 'ok' ? 'ok' : 'error';
      button.disabled = false;
      if (result === 'ok') form.reset();
      const gtag = (window as any).gtag;
      if (typeof gtag === 'function') gtag('event', result === 'ok' ? 'newsletter_signup' : 'newsletter_signup_error', { result, page: location.pathname });
    });
  });

  // Without JavaScript the form posts to /api/subscribe, which sends people
  // back to /subscribe/?status=…; show that message here.
  const s = new URLSearchParams(location.search).get('status');
  if (s && MESSAGES[s]) {
    const status = document.querySelector<HTMLElement>('.signup-status');
    if (status) {
      status.hidden = false;
      status.textContent = MESSAGES[s];
      status.dataset.state = s === 'ok' ? 'ok' : 'error';
    }
  }
</script>

<style>
  .signup-status[data-state='ok'] { color: #1f7a3a; font-weight: 600; }
  .signup-status[data-state='error'] { color: var(--accent); font-weight: 600; }
  @media (prefers-color-scheme: dark) { .signup-status[data-state='ok'] { color: #6fcf8e; } }
  .signup {
    background: var(--paper-2);
    border-top: 3px solid var(--accent);
    padding: 22px 20px 20px;
  }
  .signup h2 {
    font-family: var(--serif-display);
    font-size: 26px;
    line-height: 1.15;
    margin: 4px 0 8px;
  }
  .signup .kicker { margin: 0; }
  .signup-copy { margin: 0 0 14px; font-size: 16px; color: var(--ink-2); }
  .signup-form { display: flex; flex-wrap: wrap; gap: 8px; }
  .signup-form input {
    flex: 1 1 200px;
    min-width: 0;
    font: inherit;
    font-family: var(--sans);
    font-size: 15px;
    padding: 10px 12px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper);
    color: var(--ink);
  }
  .signup-status { margin: 10px 0 0; }

  .signup-banner {
    text-align: center;
    padding: 36px 20px;
  }
  .signup-banner h2 { font-size: clamp(28px, 4vw, 36px); }
  .signup-banner .signup-copy { max-width: 34em; margin-left: auto; margin-right: auto; }
  .signup-banner .signup-form { max-width: 480px; margin: 0 auto; }
</style>
