---
import { fmtLogDay, fmtLogTime, type PoliceEntry } from '../lib/wire';

interface Props {
  day: string;
  entries: PoliceEntry[];
}
const { day, entries } = Astro.props;
---
<h4>{fmtLogDay(day)}</h4>
<ul>
  {entries.map((e) => (
    <li>
      <span class="t">{fmtLogTime(e.date)}</span>
      <span class="what">
        {e.offenses ? e.offenses.join('; ') : e.type}
        {e.charges && <span class="charges">Charges: {e.charges.join('; ')}</span>}
        {e.domestic && <span class="tag">Domestic</span>}
      </span>
      <span class="where meta">
        {e.street}
        {e.action && <>{e.street && ' · '}{e.action}</>}
        {e.pdf && <>{' · '}<a href={e.pdf}>Log</a></>}
      </span>
    </li>
  ))}
</ul>

<style>
  h4 {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 14px 0 2px;
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li {
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr);
    column-gap: 8px;
    padding: 7px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 15px;
    line-height: 1.3;
  }
  .t { font-family: var(--sans); font-size: 12px; font-weight: 600; color: var(--ink-2); padding-top: 2px; grid-row: span 2; }
  .what { overflow-wrap: anywhere; }
  .charges { display: block; font-size: 14px; color: var(--ink-2); }
  .where { grid-column: 2; }
  .tag {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid currentColor;
    border-radius: 2px;
    padding: 0 4px;
    margin-left: 6px;
    white-space: nowrap;
  }
</style>
