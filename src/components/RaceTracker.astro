---
import election from '../data/election.json';
import resultsData from '../data/election-results.json';

type Res = { leader?: string | null; margin?: number | null; prev_margin?: number | null; lead_changed_at?: string | null };
const tracker = election.tracker;
const results = (resultsData as { races?: Record<string, Res> }).races ?? {};
const fmt = (iso?: string | null) =>
  iso ? new Date(iso).toLocaleString('en-US', { timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit' }) + ' ET' : '';
const trend = (r?: Res) => {
  if (!r || r.margin == null) return '';
  const move = r.prev_margin != null && r.prev_margin !== r.margin ? ` (${r.margin > r.prev_margin ? 'up' : 'down'} from ${r.prev_margin} pts at the last check)` : '';
  return r.leader ? `${r.leader} leads by ${r.margin} pts${move}` : 'Tied';
};
const changed = (r?: Res) => (r?.lead_changed_at ? `Lead changed ${fmt(r.lead_changed_at)}` : '');
const config = JSON.stringify({ url: tracker.url, key: tracker.key, races: tracker.races });
---
<div class="track-grid">
  {tracker.races.map((t) => {
    const res = results[t.raceKey];
    return (
      <article class="track" data-race={t.id}>
        <h3>{t.label}</h3>
        <p class="track-winner" data-winner>&nbsp;</p>
        <p class="track-called" data-called>Checking the call…</p>
        {res && trend(res) && (
          <p class="track-count"><strong>State count:</strong> {trend(res)}. {changed(res) && <span>{changed(res)}.</span>}</p>
        )}
      </article>
    );
  })}
</div>
<script type="application/json" id="electscore-config" set:html={config}></script>
<script is:inline src="/election-tracker.js" defer></script>

<style is:global>
  .track-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; margin: 10px 0 8px; }
  .track { border: 1px solid var(--rule); border-top: 3px solid var(--navy); background: var(--paper-2); padding: 12px 14px; font-family: var(--sans); font-size: 14px; }
  .track h3 { margin: 0 0 2px; font-family: var(--serif-display); font-size: 20px; }
  .track-winner { margin: 6px 0 0; font-size: 18px; line-height: 1.3; }
  .track-winner strong { font-family: var(--serif-display); font-size: 22px; }
  .win-label { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-right: 4px; }
  .track-called { margin: 4px 0 8px; color: var(--ink-2); font-size: 13px; }
  .track p { margin: 6px 0 0; line-height: 1.45; }
  .track-count { padding-top: 6px; border-top: 1px solid var(--rule); }
</style>
