---
import StoryCard from './StoryCard.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import type { Story } from '../lib/content';

interface Props {
  kicker: string;
  title: string;
  dek?: string;
  stories: Story[];
}
const { kicker, title, dek, stories } = Astro.props;
const hasWire = Astro.slots.has('wire');
---
<div class="wrap">
  <header class="index-head">
    <p class="kicker">{kicker}</p>
    <h1 class="page-title">{title}</h1>
    {dek && <p class="page-dek">{dek}</p>}
  </header>
  <div class="index-grid">
    <div>
      <slot name="wire" />
      {hasWire && stories.length > 0 && <div class="section-head"><h2>Bristol Brief stories</h2></div>}
      {stories.length === 0 ? (
        !hasWire && <p class="empty">
          No stories here yet. <a href="/tips/">Tell us what we should be covering.</a>
        </p>
      ) : (
        stories.map((s) => <StoryCard story={s} variant="list" />)
      )}
    </div>
    <aside><NewsletterSignup /><slot name="rail" /></aside>
  </div>
</div>

<style>
  .index-head { border-bottom: 3px solid var(--ink); padding-bottom: 16px; margin-bottom: 8px; }
  .index-head .kicker { margin: 32px 0 0; }
  .index-head .page-title { margin-top: 4px; }
  .index-grid { display: grid; gap: 40px; grid-template-columns: 1fr; }
  @media (min-width: 1000px) {
    .index-grid { grid-template-columns: minmax(0, 1fr) 320px; }
    aside { padding-top: 18px; }
  }
  .empty { padding: 24px 0; color: var(--ink-2); }
</style>
