---
import type { TeamSchedule } from '../lib/wire';

interface Props {
  schedule: TeamSchedule;
}
const { schedule } = Astro.props;
const ET = { timeZone: 'America/New_York' } as const;
const day = (iso: string) => new Date(iso).toLocaleDateString('en-US', { ...ET, weekday: 'short', month: 'short', day: 'numeric' });
const time = (iso: string) => new Date(iso).toLocaleTimeString('en-US', { ...ET, hour: 'numeric', minute: '2-digit' });
// Results older than a week drop off; the next games are always shown.
const recent = schedule.past.filter((g) => Date.now() - Date.parse(g.date) < 8 * 864e5).slice(0, 3);
const next = schedule.next.slice(0, 3);
const vs = (g: { home: boolean; opponent: string }) => `${g.home ? 'vs.' : 'at'} ${g.opponent}`;
---
{(recent.length > 0 || next.length > 0) && (
  <div class="sched">
    {next.length > 0 && (
      <div>
        <h3>Next</h3>
        <ul>
          {next.map((g) => (
            <li>
              <span class="when">
                {g.status === 'live' ? <strong class="live">Live</strong> : <>{day(g.date)}{!g.tbd && <> · {time(g.date)}</>}</>}
              </span>
              <span class="what">
                {vs(g)}
                {g.status === 'live' && g.us != null && <> · {g.us}–{g.them}</>}
                {g.status === 'postponed' && <> · Postponed</>}
              </span>
              {g.note && <span class="note">{g.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}
    {recent.length > 0 && (
      <div>
        <h3>Results</h3>
        <ul>
          {recent.map((g) => (
            <li>
              <span class="when">{day(g.date)}</span>
              <span class="what">
                {g.result && <b class={`res res-${g.result === 'W' ? 'w' : 'l'}`}>{g.result}</b>} {g.us}–{g.them} {vs(g)}
              </span>
              {g.note && <span class="note">{g.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
)}

<style>
  .sched {
    display: grid;
    gap: 12px 20px;
    grid-template-columns: 1fr;
    margin: 4px 0 14px;
    padding: 12px 14px;
    background: var(--paper-2);
    border-radius: 4px;
    font-family: var(--sans);
    font-size: 14px;
  }
  @media (min-width: 480px) { .sched { grid-template-columns: 1fr 1fr; } }
  h3 {
    margin: 0 0 6px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 4px 0; line-height: 1.3; }
  li + li { border-top: 1px solid var(--rule); }
  .when { display: block; font-size: 12px; color: var(--ink-2); }
  .what { display: block; font-weight: 600; color: var(--ink); }
  .note { display: block; font-size: 12px; color: var(--ink-2); }
  .res { display: inline-block; min-width: 1.8em; font-weight: 800; }
  .res-w { color: #1f7a3a; }
  .res-l { color: var(--accent); }
  .live { color: var(--accent); text-transform: uppercase; letter-spacing: 0.06em; }
  @media (prefers-color-scheme: dark) { .res-w { color: #6fcf8e; } }
</style>
