---
import type { WireItem } from '../lib/wire';
import { timeAgo, fmtTime } from '../lib/wire';
import { townName } from '../site.config';

interface Props {
  items: WireItem[];
  showSummary?: boolean;
  showTowns?: boolean;
  empty?: string;
  /** Show the time of day instead of "3h ago" (for lists grouped under day headings). */
  clock?: boolean;
}
const { items, showSummary = false, showTowns = true, empty = 'Nothing new yet.', clock = false } = Astro.props;
---
{items.length === 0 ? (
  <p class="meta">{empty}</p>
) : (
  <ol class="wire">
    {items.map((i) => (
      <li
        class="wire-item"
        data-towns={[...i.towns, ...(i.countywide ? ['countywide'] : [])].join(' ')}
        data-source={i.source}
        data-category={i.category}
      >
        <p class="wire-meta meta">
          <span class="wire-source">{i.sourceName}</span>
          {showTowns && i.towns.length > 0 && <span> · {i.towns.slice(0, 2).map(townName).join(', ')}</span>}
          {showTowns && i.countywide && <span> · Region</span>}
          {' · '}
          {clock ? <time datetime={i.date}>{fmtTime(i.date)}</time> : <time datetime={i.date} data-ago>{timeAgo(i.date)}</time>}
        </p>
        <h3 class="wire-title">
          <a href={i.link} {...(!i.manual || i.external ? { target: '_blank', rel: 'noopener' } : {})}>{i.title}</a>
        </h3>
        {showSummary && i.summary && <p class="wire-summary">{i.summary}</p>}
        {i.image && <img class="wire-thumb" src={i.image} alt={i.imageAlt ?? ''} loading="lazy" />}
      </li>
    ))}
  </ol>
)}

<script>
  import { timeAgo } from '../lib/time.mjs';

  document.querySelectorAll<HTMLTimeElement>('time[data-ago]').forEach((t) => {
    t.textContent = timeAgo(t.dateTime);
  });
</script>

<style>
  .wire { list-style: none; margin: 0; padding: 0; }
  .wire-item { padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .wire-item:has(.wire-thumb) { display: grid; grid-template-columns: 1fr 96px; column-gap: 14px; }
  .wire-item:has(.wire-thumb) > :not(.wire-thumb) { grid-column: 1; }
  .wire-thumb { grid-column: 2; grid-row: 1 / span 3; width: 96px; aspect-ratio: 1; object-fit: cover; }
  .wire-item:first-child { padding-top: 0; }
  .wire-item:last-child { border-bottom: 0; }
  .wire-meta { margin: 0 0 3px; font-size: 12px; }
  .wire-source { font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.04em; }
  .wire-title {
    font-family: var(--serif-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
  }
  .wire-title a { color: var(--ink); text-decoration: none; }
  .wire-title a:hover { color: var(--accent); text-decoration: underline; }
  .wire-summary { margin: 5px 0 0; font-size: 15px; color: var(--ink-2); line-height: 1.45; }
</style>
