---
import { SECTIONS, TOWNS } from '../../site.config';
import type { WireItem } from '../../lib/wire';

interface Props {
  /** The story as currently shown (edits applied). Omit for a new story. */
  item?: WireItem;
  /** Feed items: the values from the feed, so unchanged fields aren't saved as edits. */
  original?: { title: string; summary: string; section: string; towns: string[] };
  until?: string;
}
const { item, original, until } = Astro.props;
const isNew = !item;
const manual = isNew || item!.manual;
const sections = new Set(item?.sections ?? []);
const towns = new Set(item?.towns ?? []);
const localDate = (iso?: string) => {
  const d = iso ? new Date(iso) : new Date();
  return new Date(d.valueOf() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
};
---
<form
  class="story-form"
  data-id={item?.id ?? ''}
  data-new={isNew ? '1' : ''}
  data-manual={manual ? '1' : ''}
  data-original={original ? JSON.stringify(original) : ''}
  novalidate
>
  <div class="cols">
    <div class="main-col">
      <label class="field">
        <span>Headline</span>
        <input type="text" name="title" value={item?.title ?? ''} maxlength="200" required />
        {original && item?.title !== original.title && (
          <small class="a-muted">Feed headline: {original.title} <button type="button" class="linkish" data-reset="title">Restore</button></small>
        )}
      </label>
      <label class="field">
        <span>Summary</span>
        <textarea name="summary" maxlength="600" rows="3">{item?.summary ?? ''}</textarea>
        {original && <small class="a-muted">Leave it as the feed's summary to keep updates from the feed.</small>}
      </label>

      {manual && (
        <>
          <label class="field">
            <span>Link to the full story (optional)</span>
            <input type="url" name="link" value={item?.external ? item.link : ''} placeholder="https://" />
            <small class="a-muted">Link to another site, or leave blank and write the story below. It gets its own page here.</small>
          </label>
          <div class="field">
            <label for="story-body"><span>Story text (used when there's no link)</span></label>
            <div class="toolbar" role="toolbar" aria-label="Formatting" aria-controls="story-body">
              <button type="button" data-fmt="bold" title="Bold (Ctrl/⌘+B)"><b>B</b></button>
              <button type="button" data-fmt="italic" title="Italic (Ctrl/⌘+I)"><i>I</i></button>
              <button type="button" data-fmt="link" title="Link (Ctrl/⌘+K)">Link</button>
              <span class="sep" aria-hidden="true"></span>
              <button type="button" data-fmt="h2" title="Subhead">Subhead</button>
              <button type="button" data-fmt="h3" title="Small subhead">Small head</button>
              <button type="button" data-fmt="list" title="Bulleted list">• List</button>
              <button type="button" data-fmt="quote" title="Quote">“ Quote</button>
              <button type="button" data-fmt="hr" title="Divider">— Divider</button>
            </div>
            <textarea id="story-body" name="body" rows="16" placeholder={'Write the story here. Leave a blank line between paragraphs.'}>{item?.body ?? ''}</textarea>
            <small class="a-muted">Select text and use the buttons, or type **bold**, *italic*, [link text](https://…), ## Subhead, - list, &gt; quote.</small>
          </div>
          <div class="two">
            <label class="field">
              <span>Byline / source</span>
              <input type="text" name="sourceName" value={item?.sourceName ?? 'The Bristol Brief'} maxlength="80" />
            </label>
            <label class="field">
              <span>Date and time</span>
              <input type="datetime-local" name="date" value={localDate(item?.date)} />
            </label>
          </div>
        </>
      )}

      <fieldset>
        <legend>Sections {manual ? '(pick at least one)' : ''}</legend>
        <div class="a-checks">
          {SECTIONS.map((s) => (
            <label><input type="checkbox" name="sections" value={s.slug} checked={sections.has(s.slug) || (isNew && s.slug === 'news')} /> {s.name}</label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend>Towns</legend>
        <div class="a-checks">
          {TOWNS.map((t) => (
            <label><input type="checkbox" name="towns" value={t.slug} checked={towns.has(t.slug)} /> {t.name}</label>
          ))}
        </div>
      </fieldset>
      {manual && (
        <section class="preview" aria-labelledby="preview-h">
          <div class="preview-head">
            <h2 id="preview-h">Preview</h2>
            <span class="a-muted" data-preview-note>How the story page will look. Updates as you type.</span>
          </div>
          <article class="story-preview" data-preview>
            <div class="sp-kicker" data-p="kicker"></div>
            <h1 class="sp-title" data-p="title"></h1>
            <p class="sp-dek" data-p="summary"></p>
            <p class="meta sp-byline" data-p="byline"></p>
            <figure class="sp-figure" data-p="figure" hidden><img alt="" /><figcaption class="meta"></figcaption></figure>
            <div class="prose sp-body" data-p="body"></div>
          </article>
        </section>
      )}
    </div>

    <aside class="side-col">
      <fieldset>
        <legend>Photo</legend>
        <div class="photo-preview" data-has={item?.image ? '1' : ''}>
          {item?.image && <img src={item.image} alt="" />}
        </div>
        <input type="hidden" name="image" value={item?.image ?? ''} />
        <label class="a-btn file-btn">
          <input type="file" accept="image/*" name="photo" />
          {item?.image ? 'Replace photo' : 'Add photo'}
        </label>
        <button type="button" class="a-btn danger remove-photo" hidden={!item?.image}>Remove photo</button>
        <label class="field" style="margin-top:12px">
          <span>Caption / alt text</span>
          <input type="text" name="imageAlt" value={item?.imageAlt ?? ''} maxlength="300" placeholder="Describe the photo; credit the photographer" />
        </label>
        <small class="a-muted">Photos are resized to 1600px before upload.</small>
      </fieldset>

      {isNew ? (
        <fieldset>
          <legend>Home page</legend>
          <label class="field" style="margin:0">
            <span>Feature as</span>
            <select name="feature">
              <option value="">Not featured</option>
              <option value="lead">Lead</option>
              <option value="second">Second</option>
              <option value="third">Third</option>
              <option value="rail">Top of rail</option>
            </select>
          </label>
          <small class="a-muted">For one hour, then the freshest news takes over.</small>
        </fieldset>
      ) : (
        <fieldset>
          <legend>Home page</legend>
          <p class="a-muted" style="margin:0 0 8px">
            {item!.featuredSlot
              ? `Featured as ${{ lead: 'the lead', second: 'the second story', third: 'the third story', rail: 'the top of the rail' }[item!.featuredSlot]}.`
              : 'Not featured.'}
          </p>
          <div class="btn-row">
            <button type="button" class="a-btn" data-feature="lead">Lead</button>
            <button type="button" class="a-btn" data-feature="second">Second</button>
            <button type="button" class="a-btn" data-feature="third">Third</button>
            <button type="button" class="a-btn" data-feature="rail">Rail</button>
            {item!.featuredSlot && <button type="button" class="a-btn danger" data-unfeature>Unfeature</button>}
          </div>
          <label class="field" style="margin-top:12px">
            <span>Keep featured until (optional)</span>
            <input type="datetime-local" name="until" value={until ? localDate(until) : ''} />
            <small class="a-muted">Leave blank and the pick lasts one hour, then the freshest news takes over.</small>
          </label>
          <label class="inline" style="margin-top:12px"><input type="checkbox" name="hidden" checked={item!.hidden} /> Hide from the site</label>
        </fieldset>
      )}

      <div class="btn-row save-row">
        <button type="submit" class="a-btn primary">{isNew ? 'Publish story' : 'Save changes'}</button>
        {!isNew && manual && <button type="button" class="a-btn danger" data-delete>Delete story</button>}
      </div>
    </aside>
  </div>
</form>

<script>
  import { saveOp, resizeImage, uploadImage, toast } from '../../lib/admin/client';
  import { renderBody } from '../../lib/body';

  const form = document.querySelector<HTMLFormElement>('.story-form')!;
  const id = form.dataset.id!;
  const isNew = form.dataset.new === '1';
  const manual = form.dataset.manual === '1';
  const original = form.dataset.original ? JSON.parse(form.dataset.original) : null;
  const preview = form.querySelector<HTMLElement>('.photo-preview')!;
  const imageInput = form.elements.namedItem('image') as HTMLInputElement;
  const removeBtn = form.querySelector<HTMLButtonElement>('.remove-photo')!;
  let pendingPhoto: { dataUrl: string; name: string } | null = null;

  const val = (name: string) => ((form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? '').trim();
  const checked = (name: string) =>
    [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value);
  const same = (a: string[], b: string[]) => a.length === b.length && a.every((x) => b.includes(x));
  const toIso = (local: string) => (local ? new Date(local).toISOString() : null);

  form.querySelector<HTMLInputElement>('input[name="photo"]')!.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    try {
      const dataUrl = await resizeImage(file);
      pendingPhoto = { dataUrl, name: file.name };
      preview.innerHTML = `<img src="${dataUrl}" alt="" />`;
      removeBtn.hidden = false;
      form.dispatchEvent(new Event('input'));
    } catch (err: any) {
      toast(err.message, { error: true });
    }
  });

  removeBtn.addEventListener('click', () => {
    pendingPhoto = null;
    imageInput.value = '';
    preview.innerHTML = '';
    removeBtn.hidden = true;
    form.dispatchEvent(new Event('input'));
  });

  form.querySelector('[data-reset="title"]')?.addEventListener('click', () => {
    (form.elements.namedItem('title') as HTMLInputElement).value = original.title;
  });

  function collect() {
    const title = val('title');
    const summary = val('summary');
    const sections = checked('sections');
    const towns = checked('towns');
    const fields: Record<string, unknown> = {};
    if (manual) {
      Object.assign(fields, {
        title,
        summary,
        sections,
        towns,
        link: val('link') || null,
        body: (form.elements.namedItem('body') as HTMLTextAreaElement).value,
        sourceName: val('sourceName') || null,
        date: toIso(val('date')),
      });
    } else {
      // Only save what differs from the feed, so unchanged fields keep updating.
      fields.title = title === original.title ? null : title;
      fields.summary = summary === original.summary ? null : summary;
      fields.sections = same(sections, [original.section]) ? null : sections;
      fields.towns = same(towns, original.towns) ? null : towns;
      fields.hidden = (form.elements.namedItem('hidden') as HTMLInputElement).checked || null;
    }
    fields.imageAlt = val('imageAlt') || null;
    return { title, fields };
  }

  function check(title: string, fields: Record<string, any>) {
    if (!title) return 'Add a headline.';
    if (manual && !(fields.sections as string[]).length) return 'Pick at least one section.';
    if (manual && !fields.link && !String(fields.body ?? '').trim()) return 'Add a link or write the story text.';
    return null;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const { title, fields } = collect();
    const problem = check(title, fields);
    if (problem) return toast(problem, { error: true });
    submit.disabled = true;
    try {
      if (pendingPhoto) {
        toast('Uploading photo…');
        const path = await uploadImage(pendingPhoto.dataUrl, pendingPhoto.name);
        if (!path) return;
        imageInput.value = path;
        pendingPhoto = null;
      }
      fields.image = imageInput.value || null;
      const res = isNew
        ? await saveOp(
            { type: 'addManual', story: fields, feature: val('feature') || undefined },
            `add story "${title.slice(0, 60)}"`,
          )
        : await saveOp({ type: 'update', id, fields }, `edit "${title.slice(0, 60)}"`);
      if (res.ok) {
        setTimeout(() => {
          if (isNew && res.id) location.href = `/admin/edit/?id=${encodeURIComponent(res.id)}`;
          else location.reload();
        }, 800);
      }
    } finally {
      submit.disabled = false;
    }
  });

  form.querySelectorAll<HTMLButtonElement>('[data-feature]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      const res = await saveOp(
        { type: 'feature', id, slot: btn.dataset.feature, until: toIso(val('until')) },
        `feature "${val('title').slice(0, 60)}" as ${btn.dataset.feature}`,
      );
      if (res.ok) setTimeout(() => location.reload(), 800);
      else btn.disabled = false;
    }),
  );

  form.querySelector('[data-unfeature]')?.addEventListener('click', async () => {
    const res = await saveOp({ type: 'unfeature', id }, `unfeature "${val('title').slice(0, 60)}"`);
    if (res.ok) setTimeout(() => location.reload(), 800);
  });

  // Formatting toolbar: wraps the selection or starts lines with a marker, in
  // the same plain-text syntax the story page renders.
  const body = form.querySelector<HTMLTextAreaElement>('textarea[name="body"]');
  function edit(fn: (text: string, start: number, end: number) => { text: string; start: number; end: number }) {
    if (!body) return;
    body.focus();
    const before = body.value;
    const r = fn(before, body.selectionStart, body.selectionEnd);
    // Replace only the part that changed, through execCommand where the
    // browser supports it, so Ctrl/⌘+Z undoes a toolbar edit.
    let p = 0;
    while (p < before.length && p < r.text.length && before[p] === r.text[p]) p++;
    let q = 0;
    while (q < before.length - p && q < r.text.length - p && before[before.length - 1 - q] === r.text[r.text.length - 1 - q]) q++;
    const mid = r.text.slice(p, r.text.length - q);
    body.setSelectionRange(p, before.length - q);
    const ok = mid ? document.execCommand('insertText', false, mid) : document.execCommand('delete');
    if (!ok || body.value !== r.text) body.value = r.text;
    body.setSelectionRange(r.start, r.end);
    body.dispatchEvent(new Event('input', { bubbles: true }));
  }
  const wrap = (mark: string, placeholder: string) =>
    edit((t, a, b) => {
      const sel = t.slice(a, b) || placeholder;
      // Toggle off if the selection is already wrapped.
      if (t.slice(a - mark.length, a) === mark && t.slice(b, b + mark.length) === mark && a !== b)
        return { text: t.slice(0, a - mark.length) + sel + t.slice(b + mark.length), start: a - mark.length, end: b - mark.length };
      return { text: t.slice(0, a) + mark + sel + mark + t.slice(b), start: a + mark.length, end: a + mark.length + sel.length };
    });
  const lines = (prefix: string, placeholder: string) =>
    edit((t, a, b) => {
      const ls = t.lastIndexOf('\n', a - 1) + 1;
      let le = t.indexOf('\n', b);
      if (le === -1) le = t.length;
      const block = t.slice(ls, le) || placeholder;
      const strip = /^(#{2,3} |[-*] |> ?)/;
      const all = block.split('\n').every((l) => !l.trim() || l.startsWith(prefix));
      const out = block
        .split('\n')
        .map((l) => (!l.trim() ? l : all ? l.slice(prefix.length) : prefix + l.replace(strip, '')))
        .join('\n');
      // Headings and quotes read better set off by blank lines.
      const before = ls > 0 && t[ls - 2] !== '\n' && t[ls - 1] === '\n' && prefix !== '- ' ? '\n' : '';
      return { text: t.slice(0, ls) + before + out + t.slice(le), start: ls + before.length, end: ls + before.length + out.length };
    });
  const actions: Record<string, () => void> = {
    bold: () => wrap('**', 'bold text'),
    italic: () => wrap('*', 'italic text'),
    link: () => {
      const url = prompt('Link address (https://…)', 'https://');
      if (!url || url === 'https://') return;
      if (!/^(https?:\/\/|mailto:)\S+$/.test(url)) return toast('Links must start with https:// or http:// (or mailto:).', { error: true });
      edit((t, a, b) => {
        const label = t.slice(a, b) || 'link text';
        const ins = `[${label}](${url})`;
        return { text: t.slice(0, a) + ins + t.slice(b), start: a + 1, end: a + 1 + label.length };
      });
    },
    h2: () => lines('## ', 'Subhead'),
    h3: () => lines('### ', 'Small subhead'),
    list: () => lines('- ', 'List item'),
    quote: () => lines('> ', 'Quote'),
    hr: () =>
      edit((t, a) => {
        const pre = t.slice(0, a).replace(/\n*$/, '');
        const ins = (pre ? '\n\n' : '') + '---\n\n';
        return { text: pre + ins + t.slice(a).replace(/^\n*/, ''), start: pre.length + ins.length, end: pre.length + ins.length };
      }),
  };
  form.querySelectorAll<HTMLButtonElement>('[data-fmt]').forEach((b) =>
    b.addEventListener('mousedown', (e) => e.preventDefault()),
  );
  form.querySelectorAll<HTMLButtonElement>('[data-fmt]').forEach((b) =>
    b.addEventListener('click', () => actions[b.dataset.fmt!]?.()),
  );
  body?.addEventListener('keydown', (e) => {
    if (!(e.ctrlKey || e.metaKey) || e.altKey) return;
    const key = { b: 'bold', i: 'italic', k: 'link' }[e.key.toLowerCase()];
    if (key) {
      e.preventDefault();
      actions[key]();
    }
  });

  // Live preview of the story page.
  const pv = form.querySelector<HTMLElement>('[data-preview]');
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const labelFor = (name: string, value: string) =>
    form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`)?.parentElement?.textContent?.trim() ?? value;
  function renderPreview() {
    if (!pv) return;
    const part = (p: string) => pv.querySelector<HTMLElement>(`[data-p="${p}"]`)!;
    const link = val('link');
    const kick = [
      ...checked('sections').map((s) => `<span class="kicker">${esc(labelFor('sections', s))}</span>`),
      ...checked('towns').map((t) => `<span class="meta">${esc(labelFor('towns', t))}</span>`),
    ];
    part('kicker').innerHTML = kick.join('');
    part('title').textContent = val('title') || 'Headline';
    part('title').classList.toggle('empty', !val('title'));
    part('summary').textContent = val('summary');
    part('summary').hidden = !val('summary');
    const when = val('date') ? new Date(val('date')) : new Date();
    part('byline').textContent = `${val('sourceName') || 'The Bristol Brief'} · ${when.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}`;
    const img = pendingPhoto?.dataUrl || imageInput.value;
    const fig = part('figure');
    fig.hidden = !img;
    if (img) {
      fig.querySelector('img')!.src = img;
      fig.querySelector('figcaption')!.textContent = val('imageAlt');
    }
    const bodyEl = part('body');
    if (link) bodyEl.innerHTML = `<p class="a-muted">This story links to <a href="${esc(link)}" target="_blank" rel="noopener">${esc(link)}</a>, so it won't get its own page. Clear the link to publish the text below as a story page.</p>`;
    else bodyEl.innerHTML = renderBody(body?.value ?? '') || '<p class="a-muted">The story text will appear here.</p>';
  }
  let queued = false;
  const schedule = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      renderPreview();
    });
  };
  form.addEventListener('input', schedule);
  form.addEventListener('change', schedule);
  renderPreview();

  form.querySelector('[data-delete]')?.addEventListener('click', async () => {
    if (!confirm('Delete this story? This removes it from the site.')) return;
    const res = await saveOp({ type: 'deleteManual', id }, `delete "${val('title').slice(0, 60)}"`);
    if (res.ok) setTimeout(() => (location.href = '/admin/'), 800);
  });
</script>

<style>
  .cols { display: grid; gap: 28px; grid-template-columns: 1fr; }
  @media (min-width: 960px) { .cols { grid-template-columns: minmax(0, 1fr) 340px; } }
  .two { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
  small { display: block; margin-top: 4px; font-size: 12px; }
  .linkish { background: none; border: 0; padding: 0; color: var(--link); text-decoration: underline; cursor: pointer; font: inherit; }
  .photo-preview img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; margin-bottom: 8px; display: block; background: var(--paper-2); }
  .file-btn { position: relative; overflow: hidden; }
  .file-btn input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .btn-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .save-row { padding: 6px 0 10px; }
  .save-row .primary { font-size: 15px; padding: 9px 18px; }
  label.inline { display: flex; gap: 8px; align-items: center; font-size: 14px; }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
    padding: 6px;
    margin-top: 4px;
    border: 1px solid var(--rule);
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    background: var(--paper-2);
  }
  .toolbar button {
    font: 600 13px/1 var(--sans);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 6px 9px;
    cursor: pointer;
  }
  .toolbar button:hover { border-color: var(--ink-2); }
  .toolbar .sep { width: 1px; align-self: stretch; background: var(--rule); margin: 0 4px; }
  .toolbar + textarea { border-top-left-radius: 0; border-top-right-radius: 0; margin-top: 0; }
  .preview { margin-top: 28px; border-top: 3px solid var(--ink); padding-top: 10px; }
  .preview-head { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; justify-content: space-between; }
  .preview-head h2 { font: 800 14px var(--sans); letter-spacing: 0.1em; text-transform: uppercase; margin: 0; }
  .story-preview {
    margin-top: 12px;
    padding: 20px 22px 8px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper);
  }
</style>

<style is:global>
  /* The preview is filled in by script, so these can't be scoped. */
  .story-preview .sp-kicker { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; min-height: 1em; }
  .story-preview .sp-title {
    font-family: var(--serif-display);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.08;
    margin: 8px 0 10px;
  }
  .story-preview .sp-title.empty { color: var(--ink-2); opacity: 0.5; }
  .story-preview .sp-dek { font-family: var(--serif-body); font-size: 20px; line-height: 1.4; color: var(--ink-2); margin: 0 0 10px; }
  .story-preview .sp-byline { margin: 0 0 16px; }
  .story-preview .sp-figure { margin: 0 0 18px; }
  .story-preview .sp-figure img { width: 100%; display: block; }
  .story-preview .sp-figure figcaption { margin-top: 6px; }
  .story-preview .sp-body { font-family: var(--serif-body); font-size: 19px; line-height: 1.6; }
  .story-preview .sp-body a { color: var(--link); }
  /* Undo the admin's section-heading style so subheads look as they will on the site. */
  .admin .story-preview .sp-body h2 {
    font-family: var(--serif-display);
    font-size: 28px;
    line-height: 1.2;
    text-transform: none;
    letter-spacing: normal;
