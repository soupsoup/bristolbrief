---
// The story table shared by the main list and the archive: one row per story
// with its feature, hide and edit actions.
import { fmtAdminDate } from '../../lib/admin/data';
import { SLOT_LABEL, TYPE } from '../../lib/admin/labels';
import { SECTIONS, sectionName, townName } from '../../site.config';

import type { WireItem } from '../../lib/wire';

interface Props {
  items: WireItem[];
}
const { items } = Astro.props;
---
<table class="items">
  <thead>
    <tr><th class="thumb-col"></th><th>Story</th><th class="act-col">Actions</th></tr>
  </thead>
  <tbody>
    {items.map((i) => (
      <tr
        data-id={i.id}
        data-q={`${i.title} ${i.originalTitle ?? ''} ${i.sourceName}`.toLowerCase()}
        data-source={i.source}
        data-category={i.category}
        data-towns={i.towns.join(' ')}
        data-sections={i.sections.join(' ')}
        data-section-order={String(Math.max(0, SECTIONS.findIndex((sec) => sec.slug === i.sections[0]))).padStart(2, '0')}
        data-section-label={sectionName(i.sections[0] ?? i.section)}
        data-countywide={i.countywide ? '1' : undefined}
        data-date={i.date}
        data-undated={i.undated ? '1' : undefined}
        data-source-name={i.sourceName}
        data-title={i.title}
        data-town-label={i.towns.length ? i.towns.map(townName).sort()[0] : i.countywide ? 'Region' : ''}
        data-status={[
          i.featuredRank != null && 'featured',
          i.edited && 'edited',
          i.hidden && 'hidden',
          i.manual && 'manual',
          i.image && 'photo',
        ].filter(Boolean).join(' ')}
        class={i.hidden ? 'is-hidden' : undefined}
      >
        <td class="thumb-col">{i.image ? <img src={i.image} alt="" loading="lazy" data-thumb /> : null}</td>
        <td>
          <div class="badges">
            {i.featuredSlot && <span class="a-badge featured">{SLOT_LABEL[i.featuredSlot]}</span>}
            {i.manual && <span class="a-badge manual">Added here</span>}
            {i.edited && <span class="a-badge">Edited</span>}
            {i.hidden && <span class="a-badge hidden">Hidden</span>}
          </div>
          <a class="i-title" href={`/admin/edit/?id=${encodeURIComponent(i.id)}`}>{i.title}</a>
          {i.originalTitle && <div class="a-muted orig">Feed headline: {i.originalTitle}</div>}
          <div class="a-muted meta">
            {i.sourceName} · {TYPE[i.category] ?? i.category} · {i.undated ? `date unknown (first seen ${fmtAdminDate(i.date)})` : fmtAdminDate(i.date)}
            {' · '}{i.sections.map(sectionName).join(', ')}
            {i.towns.length > 0 && <> · {i.towns.map(townName).join(', ')}</>}
            {i.countywide && <> · Region</>}
          </div>
        </td>
        <td class="act-col">
          {i.featuredRank == null ? (
            <select class="a-btn feature-select" aria-label="Feature on the home page">
              <option value="">Feature as…</option>
              <option value="lead">Lead</option>
              <option value="second">Second</option>
              <option value="third">Third</option>
              <option value="rail">Top of rail</option>
            </select>
          ) : (
            <button class="a-btn" data-op="unfeature">Unfeature</button>
          )}
          <button class="a-btn" data-op={i.hidden ? 'show' : 'hide'}>{i.hidden ? 'Show' : 'Hide'}</button>
          <a class="a-btn" href={`/admin/edit/?id=${encodeURIComponent(i.id)}`}>Edit</a>
          <a class="a-btn" href={i.link} target="_blank" rel="noopener" aria-label="Open original">↗</a>
        </td>
      </tr>
    ))}
  </tbody>
</table>

<script>
  import { saveOp } from '../../lib/admin/client';

  // A photo uploaded moments ago isn't on the site until the redeploy finishes.
  const pending = (img: HTMLImageElement) =>
    img.replaceWith(Object.assign(document.createElement('span'), { className: 'pending', textContent: 'Publishing…' }));
  document.querySelectorAll<HTMLImageElement>('img[data-thumb]').forEach((img) => {
    if (img.complete && img.naturalWidth === 0) pending(img);
    else img.addEventListener('error', () => pending(img));
  });

  // "Feature as…" menus on each row.
  document.addEventListener('change', async (e) => {
    const sel = (e.target as HTMLElement).closest<HTMLSelectElement>('select.feature-select');
    if (!sel || !sel.value) return;
    const row = sel.closest<HTMLElement>('[data-id]')!;
    const title = row.querySelector('.i-title')?.textContent?.trim().slice(0, 60) ?? row.dataset.id;
    sel.disabled = true;
    const res = await saveOp({ type: 'feature', id: row.dataset.id, slot: sel.value }, `feature "${title}" as ${sel.value}`);
    if (res.ok) setTimeout(() => location.reload(), 700);
    else {
      sel.disabled = false;
      sel.value = '';
    }
  });

  // Row and featured-list actions.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-op]');
    if (!btn) return;
    const holder = btn.closest<HTMLElement>('[data-id]')!;
    const id = holder.dataset.id!;
    const title = holder.querySelector('.i-title, .f-title a')?.textContent?.trim().slice(0, 60) ?? id;
    const kind = btn.dataset.op!;
    const ops: Record<string, [Record<string, unknown>, string]> = {
      unfeature: [{ type: 'unfeature', id }, `unfeature "${title}"`],
      move: [{ type: 'move', id, direction: btn.dataset.direction }, `move "${title}" ${btn.dataset.direction}`],
      hide: [{ type: 'update', id, fields: { hidden: true } }, `hide "${title}"`],
      show: [{ type: 'update', id, fields: { hidden: null } }, `show "${title}"`],
    };
    const [op, summary] = ops[kind];
    btn.disabled = true;
    const res = await saveOp(op, summary);
    if (res.ok) setTimeout(() => location.reload(), 700);
    else btn.disabled = false;
  });
</script>

<style>
  .feature-select { width: auto; padding: 5px 6px; }
  table.items { width: 100%; border-collapse: collapse; }
  table.items th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-2); padding: 6px 8px; border-bottom: 2px solid var(--ink); }
  table.items td { padding: 10px 8px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .thumb-col { width: 72px; }
  .thumb-col img { width: 64px; height: 48px; object-fit: cover; display: block; }
  .thumb-col :global(.pending) { font-size: 11px; color: var(--ink-2); }
  .act-col { width: 1%; white-space: nowrap; text-align: right; }
  .act-col .a-btn { margin-left: 4px; }
  .badges { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 3px; }
  .badges:empty { display: none; }
  .i-title { font-weight: 700; color: var(--ink); text-decoration: none; font-size: 16px; }
  .i-title:hover { color: var(--accent); text-decoration: underline; }
  .orig { font-size: 13px; font-style: italic; }
  .meta { font-size: 13px; margin-top: 2px; }
  tr.is-hidden .i-title { color: var(--ink-2); text-decoration: line-through; }
  @media (max-width: 700px) {
    .thumb-col { display: none; }
    table.items td.act-col { white-space: normal; text-align: left; }
    table.items tr { display: grid; grid-template-columns: 1fr; }
    table.items thead { display: none; }
    .act-col .a-btn { margin: 4px 4px 0 0; }
  }
</style>
