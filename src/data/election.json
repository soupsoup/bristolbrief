 "questions": [
  {
   "n": 1,
   "key": "q1",
   "title": "Public records law for the Legislature and governor",
   "type": "Law proposed by initiative petition",
   "summary": "Would make most records held by the Legislature and the Office of the Governor public records, with exemptions for policy-development documents and for constituent-service communications.",
   "yes": "Makes most records held by the Legislature and the Office of the Governor public records under the Massachusetts Public Records Law.",
   "no": "Makes no change to the Massachusetts Public Records Law."
  },
  {
   "n": 2,
   "key": "q2",
   "title": "Union rights for public defenders",
   "type": "Law proposed by initiative petition",
   "summary": "Would let employees of the Committee for Public Counsel Services bargain collectively and require the committee to ask the governor for money to fund any contract.",
   "yes": "Specifies that Committee for Public Counsel Services employees may form a union to collectively bargain with their employer.",
   "no": "Makes no change to the law governing labor relations for those employees."
  },
  {
   "n": 3,
   "key": "q3",
   "title": "All-party primaries",
   "type": "Law proposed by initiative petition",
   "summary": "Would replace party primaries for state elections with one primary where all candidates appear on one ballot and the top two advance, and would require governor and lieutenant governor candidates to run jointly in the primary.",
   "yes": "Eliminates separate party primaries for state elections and requires a single primary in which all candidates appear on one ballot and the top two advance to the general election.",
   "no": "Makes no change to the laws governing primary elections."
  },
  {
   "n": 4,
   "key": "q4",
   "title": "Same-day voter registration",
   "type": "Law proposed by initiative petition",
   "summary": "Would let eligible people register to vote, or update their registration address, at their polling place on Election Day with proof of residency and a signed oath. It would take effect January 1, 2028.",
   "yes": "Permits eligible citizens to register to vote or update their voter registration address at their polling place on Election Day.",
   "no": "Makes no change to the laws governing voter registration."
  },
  {
   "n": 5,
   "key": "q5",
   "title": "State revenue limit and taxpayer rebates",
   "type": "Law proposed by initiative petition",
   "summary": "Would cap state revenue each year at the prior year's amount plus the average growth in Massachusetts wages over three years, with any excess refunded to taxpayers the following year. The limit would apply from July 1, 2027.",
   "yes": "Changes the limit on state revenue collection and provides for a rebate of revenue above that limit.",
   "no": "Makes no change in the law on state revenue collection."
  },
  {
   "n": 6,
   "key": "q6",
   "title": "Nature for All conservation fund",
   "type": "Law proposed by initiative petition",
   "summary": "Would create a Nature for All Fund for land and natural resource conservation, paid for by state sales and use taxes on sporting goods, recreational vehicles and golf courses, with a 15-member board. It would take effect July 1, 2027.",
   "yes": "Creates a fund for natural resource conservation that receives some state taxes collected on sporting goods, recreational vehicles and golf courses.",
   "no": "Does not create the fund or change how sales and use taxes are spent."
  },
  {
   "n": 7,
   "key": "q7",
   "title": "Single-family homes on 5,000 sq. ft. lots",
   "type": "Law proposed by initiative petition",
   "summary": "Would allow single-family homes in residentially zoned areas on lots of at least 5,000 square feet with 50 feet of street frontage and public water and sewer, while letting towns regulate height, setbacks, open space, parking and short-term rentals.",
   "yes": "Allows single-family homes on lots of 5,000 square feet or more in residential areas, subject to reasonable local regulation.",
   "no": "Makes no change to the law on building single-family homes."
  },
  {
   "n": 8,
   "key": "q8",
   "title": "Repeal of recreational marijuana sales",
   "type": "Law proposed by initiative petition",
   "summary": "Would repeal the laws that legalize, regulate and tax retail sales of adult-use marijuana, allow adults 21 and older to possess up to one ounce, and keep the Cannabis Control Commission for the medical market only. It would take effect January 1, 2028.",
   "yes": "Prohibits the legalization, regulation and taxation of retail sales of adult recreational marijuana and changes the penalties for possession.",
   "no": "Makes no change to the law on marijuana."
  },
  {
   "n": 9,
   "key": "q9",
   "title": "2024 firearms law",
   "type": "Referendum on an existing law",
   "summary": "A referendum on the 2024 firearms law, which the House passed 124 to 33 and the Senate 35 to 5. The law covers extreme risk protection orders, ghost guns, licensing, machine-gun definitions and firearms in government buildings, polling places and schools. A yes vote keeps the law and a no vote repeals it.",
   "yes": "Keeps in place the law, which increases the regulation of firearms, including ghost guns, machine guns and assault-style weapons.",
   "no": "Repeals the law."
  }
 ],
