---
import Base from '../layouts/Base.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import { SITE, TOWNS } from '../site.config';
import { sources } from '../lib/wire';

const count = sources.filter((s) => s.enabled).length;
---
<Base title="About" description={`About ${SITE.name}.`}>
  <div class="wrap">
    <p class="kicker" style="margin:32px 0 0">About us</p>
    <h1 class="page-title" style="margin-top:4px">One front page for Bristol County</h1>
    <div class="prose">
      <p>
        News about Bristol County, Massachusetts, is spread across daily papers, nonprofit newsrooms,
        radio stations, police departments and 20 separate town and city websites. {SITE.name} brings
        it together in one place.
      </p>
      <p>
        Through the day we check {count} public feeds, keep the items that name one of the county's
        cities and towns, and sort them by town and topic. Each headline links to the original
        story on the publisher's site. We show the headline and the publisher's own summary, never the
        full article, so please support the newsrooms doing the reporting.
      </p>
      <h2>What you'll find here</h2>
      <ul>
        <li><strong>Headlines</strong> from local newsrooms, filterable by town, type and source.</li>
        <li><strong>Town hall notices</strong> and <strong>meeting agendas</strong> posted by municipal websites.</li>
        <li><strong>Weather alerts</strong> from the National Weather Service and <strong>tide times</strong> from NOAA.</li>
        <li><strong>Commuter rail alerts</strong> for the county's eight MBTA stations.</li>
      </ul>
      <h2>Join the conversation</h2>
      <p>
        Talk about local news with neighbors, share what you're seeing in your town and send us story
        ideas on our Discord.
      </p>
      <p>
        <a class="btn btn-discord" href={SITE.social.discord} target="_blank" rel="noopener"><DiscordIcon /> Join our Discord</a>
      </p>
      <h2>Coverage area</h2>
      <p>{TOWNS.map((t) => t.name).join(', ')}.</p>
      <h2>Sources and corrections</h2>
      <p>
        See <a href="/sources/">where our headlines come from</a>. Publishers who want to be added,
        removed or linked differently, and anyone who spots a headline filed under the wrong town,
        can reach us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
    <div style="max-width:40em;margin-top:40px"><NewsletterSignup /></div>
  </div>
</Base>
