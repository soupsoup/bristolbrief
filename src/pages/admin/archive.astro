---
import Admin from '../../layouts/Admin.astro';
import StoryTable from '../../components/admin/StoryTable.astro';
import { loadAdminData } from '../../lib/admin/data';
import { sources } from '../../lib/wire';
import { archivePage, splitStories, RECENT_DAYS, ARCHIVE_PAGE_SIZE } from '../../../scripts/lib/admin-rows.mjs';
import { SECTIONS, TOWNS } from '../../site.config';

export const prerender = false;

let data: Awaited<ReturnType<typeof loadAdminData>> | undefined;
let loadError = '';
try {
  data = await loadAdminData();
} catch (err: any) {
  loadError = err?.message ?? 'Could not load editorial data';
}

// Filtering happens on the server: the archive holds thousands of stories, far too many for one page.
const get = (k: string) => Astro.url.searchParams.get(k) ?? '';
const filters = { q: get('q'), source: get('source'), section: get('section'), town: get('town'), sort: get('sort') === 'oldest' ? 'oldest' : 'newest' };
const all = data?.items ?? [];
const { rows, total, archiveCount, page, pages } = archivePage(all, { ...filters, page: get('page') });
const usedSources = sources.filter((s) => splitStories(all).archive.some((i: { source: string }) => i.source === s.id));

const link = (n: number) => {
  const next = new URLSearchParams();
  for (const [k, v] of Object.entries(filters)) if (v && !(k === 'sort' && v === 'newest')) next.set(k, v);
  if (n > 1) next.set('page', String(n));
  return next.size ? `/admin/archive/?${next}` : '/admin/archive/';
};
const first = total ? (page - 1) * ARCHIVE_PAGE_SIZE + 1 : 0;
const last = Math.min(page * ARCHIVE_PAGE_SIZE, total);
---
<Admin title="Archive" active="archive">
  {loadError && <p class="a-toast error" style="position:static;transform:none;margin:16px 0">{loadError}</p>}

  <h1>Archive</h1>
  <p class="a-muted">
    Stories older than {RECENT_DAYS} days, newest first. Edit, hide or feature them from here; the
    <a href="/admin/">Stories</a> page covers the last {RECENT_DAYS} days.
  </p>

  <form class="filters" method="get" action="/admin/archive/">
    <input type="search" name="q" value={filters.q} placeholder="Search headlines" aria-label="Search headlines" />
    <select name="source" aria-label="Source">
      <option value="">All sources</option>
      {usedSources.map((s) => <option value={s.id} selected={filters.source === s.id}>{s.name}</option>)}
    </select>
    <select name="section" aria-label="Section">
      <option value="">All sections</option>
      {SECTIONS.map((sec) => <option value={sec.slug} selected={filters.section === sec.slug}>{sec.name}</option>)}
    </select>
    <select name="town" aria-label="Town">
      <option value="">All towns</option>
      {TOWNS.map((t) => <option value={t.slug} selected={filters.town === t.slug}>{t.name}</option>)}
      <option value="countywide" selected={filters.town === 'countywide'}>Region (no single town)</option>
      <option value="none" selected={filters.town === 'none'}>No town</option>
    </select>
    <select name="sort" aria-label="Sort by">
      <option value="newest" selected={filters.sort === 'newest'}>Newest first</option>
      <option value="oldest" selected={filters.sort === 'oldest'}>Oldest first</option>
    </select>
    <button class="a-btn" type="submit">Filter</button>
  </form>

  <p class="a-muted count">
    {total === 0
      ? archiveCount === 0 ? 'Nothing is old enough to archive yet.' : 'No archived stories match.'
      : `Showing ${first.toLocaleString('en-US')} to ${last.toLocaleString('en-US')} of ${total.toLocaleString('en-US')}${total !== archiveCount ? ` (${archiveCount.toLocaleString('en-US')} archived in all)` : ''}`}
  </p>

  {rows.length > 0 && <StoryTable items={rows} />}

  {pages > 1 && (
    <nav class="pager" aria-label="Archive pages">
      {page > 1 ? <a class="a-btn" href={link(page - 1)}>← Newer</a> : <span></span>}
      <span class="a-muted">Page {page} of {pages}</span>
      {page < pages ? <a class="a-btn" href={link(page + 1)}>Older →</a> : <span></span>}
    </nav>
  )}
</Admin>

<style>
  .filters { display: grid; gap: 8px; grid-template-columns: 2fr repeat(4, 1fr) auto; margin-bottom: 10px; }
  @media (max-width: 1100px) { .filters { grid-template-columns: repeat(3, 1fr); } .filters input { grid-column: 1 / -1; } }
  @media (max-width: 600px) { .filters { grid-template-columns: 1fr 1fr; } }
  .count { margin: 6px 0 10px; font-size: 14px; }
  .pager { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 16px 0 32px; }
</style>
