---
import Admin from '../../layouts/Admin.astro';
import StoryList from '../../components/admin/StoryList.astro';
import { loadAdminData } from '../../lib/admin/data';
import { SLOT_LABEL } from '../../lib/admin/labels';
import { sources } from '../../lib/wire';
import { queryStories, RECENT_DAYS, STORY_SORTS } from '../../../scripts/lib/admin-rows.mjs';
import { SECTIONS, townName } from '../../site.config';

export const prerender = false;

let data: Awaited<ReturnType<typeof loadAdminData>> | undefined;
let loadError = '';
try {
  data = await loadAdminData();
} catch (err: any) {
  loadError = err?.message ?? 'Could not load editorial data';
}
// The main page is the daily manager (last 7 days). Older stories live in the archive and
// pro-team stories, which number in the thousands, in their own list. Filtering, sorting and
// paging all happen here on the server, so the page only ever carries one page of rows.
const teamView = Astro.url.searchParams.get('teams') === '1';
const get = (k: string) => Astro.url.searchParams.get(k) ?? '';
const filters = {
  q: get('q'), source: get('source'), category: get('category'), section: get('section'),
  status: get('status'), town: get('town'), within: ['1', '3', '6', '12'].includes(get('within')) ? get('within') : '',
  sort: STORY_SORTS.includes(get('sort')) ? get('sort') : 'newest',
};
const result = queryStories(data?.items ?? [], {
  scope: teamView ? 'teams' : 'recent',
  ...filters,
  within: Number(filters.within) || 0,
  page: get('page'),
  sectionOrder: SECTIONS.map((sec) => sec.slug),
  townLabel: townName,
});
const { counts } = result;
const featured = data?.featured ?? [];
const usedSources = [
  { id: 'bristol-brief', name: 'The Bristol Brief (manual)' },
  ...sources.filter((s) => result.sourceIds.includes(s.id)),
];
const slots = [
  ...(['lead', 'second', 'third'] as const).map((slot) => ({ label: SLOT_LABEL[slot], item: featured.find((i) => i.featuredSlot === slot) })),
  ...featured.filter((i) => i.featuredSlot === 'rail').map((item) => ({ label: 'Rail', item })),
];
const clock = (d: Date) => d.toLocaleString('en-US', { timeZone: 'America/New_York', weekday: 'short', hour: 'numeric', minute: '2-digit' });
const expiresText = (id: string) => {
  const e = data?.expiry.get(id);
  if (!e?.at) return 'no time limit';
  return e.kept ? `kept until ${clock(e.at)}` : `until ${clock(e.at)}, then freshest`;
};
---
<Admin title="Stories" active="dashboard">
  {loadError && <p class="a-toast error" style="position:static;transform:none;margin:16px 0">{loadError}</p>}

  <h1>Stories</h1>
  <p class="a-muted">
    The last 7 days of what the feeds pulled in, plus stories added here. Edit a headline, add a photo or
    sections, hide an item, or feature it on the home page. Older stories are in the <a href="/admin/archive/">archive</a>.
  </p>

  <h2>Featured on the home page</h2>
  <p class="a-muted help">
    Pick the lead and the two stories under it, or add stories to the top of "Around the county".
    Each pick lasts an hour, then the freshest news takes over. Set "Keep featured until" on a
    story's edit page to hold it longer.
  </p>
  <ol class="featured">
    {slots.map(({ label, item }, n) => (
      <li data-id={item?.id} class={item ? undefined : 'empty'}>
        <span class="slot">{label}</span>
        {item ? (
          <>
            <span class="f-title">
              <a href={`/admin/edit/?id=${encodeURIComponent(item.id)}`}>{item.title}</a>
              <span class="a-muted"> · {item.sourceName} · {expiresText(item.id)}</span>
            </span>
            <span class="f-actions">
              <button class="a-btn" data-op="move" data-direction="up" disabled={n === 0} aria-label="Move up">↑</button>
              <button class="a-btn" data-op="move" data-direction="down" disabled={n >= 2 && n === slots.length - 1} aria-label="Move down">↓</button>
              <button class="a-btn danger" data-op="unfeature">Remove</button>
            </span>
          </>
        ) : (
          <span class="f-title a-muted">Automatic: freshest story</span>
        )}
      </li>
    ))}
  </ol>

  <h2>{teamView ? 'Pro team stories' : 'All stories'}</h2>
  <p class="a-muted help">
    {teamView ? (
      <>
        Red Sox, Patriots, Bruins, Celtics and Revolution stories, newest first. <a href="/admin/">Back to the last {RECENT_DAYS} days</a>
      </>
    ) : (
      <>
        The last {RECENT_DAYS} days.
        {counts.archive > 0 && (
          <>{' '}<a href="/admin/archive/">{counts.archive.toLocaleString('en-US')} older {counts.archive === 1 ? 'story is' : 'stories are'} in the archive</a>.</>
        )}
        {counts.team > 0 && (
          <>{' '}<a href="/admin/?teams=1">{counts.team.toLocaleString('en-US')} pro team stories</a> have their own list.</>
        )}
      </>
    )}
  </p>
  <StoryList
    action="/admin/"
    filters={filters}
    result={result}
    sources={usedSources}
    keep={teamView ? { teams: '1' } : {}}
    showWithin={!teamView}
    teams={teamView}
    emptyText="No stories in the last 7 days."
  />
</Admin>

<style>
  .featured { list-style: none; margin: 0; padding: 0; }
  .help { margin: -4px 0 8px; font-size: 14px; }
  .featured li.empty .f-title { font-style: italic; }
  .feature-select { width: auto; padding: 5px 6px; }
  .featured li { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--rule); flex-wrap: wrap; }
  .slot { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); width: 56px; flex: none; }
  .f-title { flex: 1 1 300px; min-width: 0; }
  .f-title a { font-weight: 700; color: var(--ink); }
  .f-actions { display: flex; gap: 6px; }
</style>
