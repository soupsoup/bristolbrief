---
import Base from '../layouts/Base.astro';
import EventList from '../components/EventList.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getUpcomingEvents } from '../lib/content';

const events = await getUpcomingEvents();
const byMonth = new Map<string, typeof events>();
for (const e of events) {
  const key = e.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', year: 'numeric' });
  byMonth.set(key, [...(byMonth.get(key) ?? []), e]);
}
---
<Base title="Events" description="Things to do across Bristol County, Massachusetts.">
  <div class="wrap">
    <p class="kicker" style="margin:32px 0 0">Calendar</p>
    <h1 class="page-title" style="margin-top:4px">Things to do in Bristol County</h1>
    <p class="page-dek">
      Festivals, meetings, markets and shows from all 20 cities and towns.
      Hosting something? <a href="/tips/">Send it our way.</a>
    </p>
    <div class="events-grid">
      <div>
        {events.length === 0 && <EventList events={[]} />}
        {[...byMonth].map(([month, list]) => (
          <section>
            <div class="section-head"><h2>{month}</h2></div>
            <EventList events={list} />
          </section>
        ))}
      </div>
      <aside><NewsletterSignup /></aside>
    </div>
  </div>
</Base>

<style>
  .events-grid { display: grid; gap: 40px; grid-template-columns: 1fr; }
  @media (min-width: 1000px) {
    .events-grid { grid-template-columns: minmax(0, 1fr) 320px; }
    aside { padding-top: 40px; }
  }
</style>
