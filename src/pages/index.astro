---
import Base from '../layouts/Base.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import WireList from '../components/WireList.astro';
import WireCard from '../components/WireCard.astro';
import TransitAlerts from '../components/TransitAlerts.astro';
import TideTable from '../components/TideTable.astro';
import MeetingCalendar from '../components/MeetingCalendar.astro';
import SocialSection from '../components/SocialSection.astro';
import { SITE, SECTIONS, TOWNS, townName } from '../site.config';
import DiscordIcon from '../components/DiscordIcon.astro';
import { storyItems, meetingItems, wireItems, pickTopStories, featuredStories, socialPosts, itemsForSection, featuredVideo, timeAgo } from '../lib/wire';

// The featured video from the TV newsrooms' YouTube channels, shown above the rail: the newest
// Bristol County video if there is one, else the newest video of any kind.
const video = featuredVideo();
// Name the place only when the video is about Bristol County; a fallback pick from a Rhode Island station gets none.
const videoWhere = video?.local ? (video.towns.length ? video.towns.map(townName).join(', ') : 'Bristol County') : '';

// Stories come from the ingested feeds (scripts/ingest.mjs) plus anything
// editors added in the admin, with their edits applied (src/data/editorial.json).
const stories = storyItems();
// Editors can pick the lead, second and third stories and add stories to the
// top of the rail. Each pick lasts an hour (unless kept longer); any empty
// slot gets the freshest story automatically.
const featured = featuredStories();
const picked = (['lead', 'second', 'third'] as const).map((slot) => featured.find((i) => i.featuredSlot === slot));
const auto = pickTopStories(stories, picked.filter((i) => !i).length, new Date(), featured);
const top = picked.map((i) => i ?? auto.shift()).filter((i): i is NonNullable<typeof i> => Boolean(i));
const [lead, ...secondary] = top;
const shown = new Set(top.map((i) => i.id));

// Render a few extra; the script below trims the rail to the height of the
// stories beside it. Without JS (and on narrow screens) CSS shows six.
const railPicks = featured.filter((i) => i.featuredSlot === 'rail');
const wire = [...railPicks, ...stories.filter((i) => !shown.has(i.id) && i.featuredRank == null)].slice(0, 12);
wire.forEach((i) => shown.add(i.id));
// Stories already on the page: the top slots and the visible part of the rail.
const visible = new Set([...top, ...wire.slice(0, 6)].map((i) => i.id));
const FEATURE_SECTIONS = ['real-estate', 'business', 'food-drink', 'things-to-do'] as const;
// Sections below the top stories run freshest first: the section whose newest
// story is most recent leads. Empty sections go last. The page rebuilds every
// 30 minutes, so the order follows the news.
const newest = (items: { date: string }[]) => items[0]?.date ?? '';
const byFreshness = <T extends { items: { date: string }[] }>(a: T, b: T) => newest(b.items).localeCompare(newest(a.items));

// First block: a row per section (News, Public Safety, Schools...) with at
// least three stories not already shown. These usually carry the freshest
// news, so they sit right under the top stories and pick their stories first.
// A story in several sections (News and Schools, say) goes in the first row
// that takes it, so no story shows twice.
const sectionRows = SECTIONS.filter((sec) => !(FEATURE_SECTIONS as readonly string[]).includes(sec.slug))
  .map((sec) => {
    const items = stories.filter((i) => i.sections.includes(sec.slug) && !shown.has(i.id)).slice(0, 3);
    if (items.length === 3) items.forEach((i) => { shown.add(i.id); visible.add(i.id); });
    return { ...sec, items };
  })
  .filter((row) => row.items.length === 3)
  .sort(byFreshness);

// Second block: Real Estate, Business, Food & Drink and Things to Do as lists
// beside the social column, skipping stories already shown above.
const featureSections = FEATURE_SECTIONS.map((slug) => ({
  slug,
  name: SECTIONS.find((s) => s.slug === slug)!.name,
  items: itemsForSection(slug).filter((i) => !visible.has(i.id)).slice(0, 5),
})).sort(byFreshness);
// Only the most recently approved post fits here; the rest are on /social/.
const social = socialPosts().slice(0, 1);
const townHall = wireItems.filter((i) => i.category === 'government').slice(0, 6);
const meetings = meetingItems().slice(0, 6);
---
<Base>
  <div class="wrap">
    {!lead ? (
      <p class="page-dek" style="margin-top:40px">Headlines will appear after the first feed update (<code>npm run ingest</code>).</p>
    ) : (
      <section class="top" aria-label="Top stories">
        <div class="top-lead" data-placement="home-lead">
          <WireCard item={lead} variant="lead" />
        </div>
        <div class="top-secondary" data-placement="home-top">
          {secondary.map((i) => <WireCard item={i} />)}
        </div>
        <aside class="top-rail" data-placement="home-rail">
          {video && (
            <div class="rail-video" data-placement="home-video" data-story-id={`video-${video.id}`} data-source={video.channel}>
              <div class="rail-head">Video</div>
              <a class="rv-thumb" href={video.link} target="_blank" rel="noopener" aria-label={`Watch: ${video.title}`}>
                <img src={video.thumbnail} alt="" width="320" height="180" decoding="async" />
                <span class="rv-play" aria-hidden="true">▶</span>
              </a>
              <p class="rv-where">{videoWhere}</p>
              <h2 class="wcard-title rv-title"><a href={video.link} target="_blank" rel="noopener">{video.title}</a></h2>
              <p class="meta rv-meta">{video.channelName} · <time datetime={video.published}>{timeAgo(video.published)}</time></p>
              <a class="video-more" href="/videos/">More videos →</a>
            </div>
          )}
          <div class="rail-head">Around the county</div>
          <div class="rail-pin">
            <span class="pin-label">Power outages</span>
            <a class="pin-title" href="https://outagemap.ma.nationalgridus.com/" target="_blank" rel="noopener">National Grid outage map ↗</a>
            <a class="pin-title" href="https://outagemap.eversource.com/external/default.html" target="_blank" rel="noopener">Eversource outage map ↗</a>
          </div>
          <a class="discord-pin" href={SITE.social.discord} target="_blank" rel="noopener">
            <DiscordIcon size={28} />
            <span>
              <span class="dp-label">Join the conversation</span>
              <span class="dp-title">Talk local news with neighbors on the Bristol Brief Discord ↗</span>
            </span>
          </a>
          <WireList items={wire} />
          <a class="rail-more" href="/news/">All local headlines →</a>
        </aside>
      </section>
    )}

    <div class="signup-row">
      <NewsletterSignup variant="banner" />
    </div>

    <div class="lower">
      <div class="lower-main">
        {sectionRows.map((row) => (
          <section data-placement={`home-${row.slug}`}>
            <div class="section-head">
              <h2>{row.name}</h2>
              <a href={`/section/${row.slug}/`}>More {row.name} →</a>
            </div>
            <div class="grid-3">
              {row.items.map((i) => <WireCard item={i} />)}
            </div>
          </section>
        ))}
      </div>
      <aside class="lower-rail">
        <div class="section-head">
          <h2>Commuter rail</h2>
          <a href="/transit/">More →</a>
        </div>
        <TransitAlerts compact />
        <div class="section-head">
          <h2>Tides</h2>
          <a href="/weather/#tides">All stations →</a>
        </div>
        <TideTable stations={['8447636', '8447386']} count={2} />
        <div class="section-head">
          <h2>From town hall</h2>
          <a href="/news/?category=government">More →</a>
        </div>
        <WireList items={townHall} />
        <div class="section-head">
          <h2>Public meetings</h2>
          <a href="/meetings/">All →</a>
        </div>
        <MeetingCalendar limit={3} />
        <WireList items={meetings} />
        <div class="section-head">
          <h2>Your town</h2>
        </div>
        <ul class="town-chips">
          {TOWNS.map((t) => <li><a href={`/towns/${t.slug}/`}>{t.name}</a></li>)}
        </ul>
      </aside>
    </div>

    <div class="feature-band">
      <div class="feature-main">
        {featureSections.map((sec) => (
          <section aria-labelledby={`sec-${sec.slug}`} data-placement={`home-${sec.slug}`}>
            <div class="section-head">
              <h2 id={`sec-${sec.slug}`}>{sec.name}</h2>
              <a href={`/section/${sec.slug}/`}>All {sec.name.toLowerCase()} headlines →</a>
            </div>
            <WireList items={sec.items} showSummary empty={`No recent ${sec.name.toLowerCase()} headlines.`} />
          </section>
        ))}
      </div>
      <aside class="feature-rail" aria-labelledby="social-head">
        <div class="section-head">
          <h2 id="social-head">On social</h2>
          {socialPosts().length > 1 && <a href="/social/">More posts →</a>}
        </div>
        {social.length > 0
          ? <SocialSection posts={social} columns={1} />
          : <p class="meta">No posts yet.</p>}
      </aside>
    </div>
  </div>
</Base>

<script>
  // Show only as many rail headlines as fit beside the lead + secondary stories.
  const rail = document.querySelector<HTMLElement>('.top-rail');
  // The featured video takes about as much room as two headlines.
  const MIN = rail?.querySelector('.rail-video') ? 2 : 4;
  const left = document.querySelector<HTMLElement>('.top-secondary');

  function fit() {
    if (!rail || !left) return;
    const items = [...rail.querySelectorAll<HTMLElement>('.wire-item')];
    rail.classList.add('fitted');
    items.forEach((el) => (el.hidden = false));
    // Stacked (single-column) layout: fall back to a fixed count.
    if (!matchMedia('(min-width: 1000px)').matches) {
      items.forEach((el, i) => (el.hidden = i >= 6));
      return;
    }
    const limit = left.getBoundingClientRect().bottom;
    const more = rail.querySelector<HTMLElement>('.rail-more');
    const reserve = more ? more.offsetHeight + 10 : 0;
    for (let i = items.length - 1; i >= MIN; i--) {
      if (items[i].getBoundingClientRect().bottom + reserve <= limit) break;
      items[i].hidden = true;
    }
  }

  fit();
  document.fonts?.ready.then(fit);
  let t: number | undefined;
  addEventListener('resize', () => {
    clearTimeout(t);
    t = window.setTimeout(fit, 100);
  });
</script>

<style>
  .top {
    display: grid;
    gap: 28px;
    padding-top: 28px;
    grid-template-columns: 1fr;
    grid-template-areas: 'lead' 'secondary' 'rail';
  }
  .top-lead { grid-area: lead; }
  .top-secondary { grid-area: secondary; display: grid; gap: 28px; }
  .top-rail { grid-area: rail; }

  @media (min-width: 720px) {
    .top-secondary { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1000px) {
    .top {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: 'lead rail' 'secondary rail';
      align-items: start;
      column-gap: 40px;
    }
    .top-rail { border-left: 1px solid var(--rule); padding-left: 28px; }
  }

  .rail-head {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-top: 3px solid var(--ink);
    padding-top: 8px;
    margin-bottom: 8px;
  }
  .rail-video { margin-bottom: 24px; }
  .rv-thumb { position: relative; display: block; aspect-ratio: 16 / 9; background: var(--paper-2); overflow: hidden; border-radius: 4px; margin-top: 12px; }
  .rv-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rv-play {
    position: absolute; right: 8px; bottom: 8px; width: 30px; height: 30px; border-radius: 50%;
    background: rgba(0, 0, 0, 0.7); color: #fff; font-size: 12px; display: grid; place-items: center; padding-left: 2px;
  }
  .rv-where { margin: 10px 0 2px; font: 800 11px var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .rv-where:empty { display: none; }
  .rv-title { margin: 0 0 4px; font-family: var(--serif-display); font-size: 19px; line-height: 1.25; }
  .rv-title a { color: var(--ink); text-decoration: none; }
  .rv-title a:hover { color: var(--accent); text-decoration: underline; }
  .rv-meta { margin: 0 0 6px; }
  .video-more { display: inline-block; font-family: var(--sans); font-size: 13px; font-weight: 600; }
  .rail-head + :global(.wire) { margin-top: 12px; }
  .top-rail:not(.fitted) :global(.wire-item:nth-child(n + 7)) { display: none; }
  .rail-pin {
    display: block;
    margin: 12px 0 4px;
    padding: 10px 12px;
    border-left: 4px solid var(--accent);
    background: var(--paper-2);
    text-decoration: none;
    color: var(--ink);
  }
  .pin-title { display: block; color: var(--ink); text-decoration: none; }
  .pin-title + .pin-title { margin-top: 4px; }
  .pin-title:hover { color: var(--accent); text-decoration: underline; }
  .pin-label {
    display: block;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pin-title { font-family: var(--serif-display); font-size: 17px; font-weight: 600; }
  .discord-pin {
    display: flex;
    gap: 12px;
    align-items: center;
    margin: 8px 0 4px;
    padding: 12px;
    border-radius: 4px;
    background: #5865f2;
    color: #fff;
    text-decoration: none;
  }
  .discord-pin:hover { background: #4752c4; }
  .discord-pin:hover .dp-title { text-decoration: underline; }
  .dp-label {
    display: block;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .dp-title { display: block; font-family: var(--serif-display); font-size: 17px; font-weight: 600; line-height: 1.25; }
  .rail-more { display: inline-block; margin-top: 10px; font-family: var(--sans); font-size: 13px; font-weight: 600; }

  .signup-row { margin-top: 44px; }

  .feature-band { display: grid; gap: 0 40px; grid-template-columns: 1fr; }
  @media (min-width: 1000px) {
    .feature-band { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  }

  .lower { display: grid; gap: 0 40px; grid-template-columns: 1fr; }
  @media (min-width: 1000px) {
    .lower { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  }
  .grid-3 { display: grid; gap: 28px; grid-template-columns: 1fr; }
  @media (min-width: 640px) {
    .grid-3 { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  }

  .town-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .town-chips a {
    display: inline-block;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    padding: 5px 10px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
  }
  .town-chips a:hover { border-color: var(--accent); color: var(--accent); }
</style>
