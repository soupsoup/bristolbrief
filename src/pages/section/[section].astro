---
import Base from '../../layouts/Base.astro';
import WireList from '../../components/WireList.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import PoliceLog from '../../components/PoliceLog.astro';
import { SECTIONS } from '../../site.config';
import { itemsForSection } from '../../lib/wire';

export function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { section: s.slug }, props: { name: s.name } }));
}

const { section } = Astro.params;
const { name } = Astro.props;
const items = itemsForSection(section);
---
<Base title={name} description={`${name} headlines from across Bristol County, Massachusetts.`}>
  <div class="wrap">
    <header class="index-head">
      <p class="kicker">Section</p>
      <h1 class="page-title">{name}</h1>
      <p class="page-dek">
        {section === 'listings'
          ? 'Homes, condos and land for sale or rent in Bristol County, from local papers and our editors. Listings stay out of the news pages.'
          : `The latest ${name.toLowerCase()} headlines from local newsrooms, police and town halls.`}
      </p>
    </header>
    <div class="index-grid">
      <WireList items={items} showSummary empty={section === 'listings' ? 'No listings right now.' : `No recent ${name.toLowerCase()} headlines.`} />
      <aside>
        {section === 'public-safety' && <PoliceLog />}
        <NewsletterSignup />
      </aside>
    </div>
  </div>
</Base>
