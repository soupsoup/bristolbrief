---
import Base from '../layouts/Base.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
---
<Base title="Subscribe" description="Get Bristol County news in your inbox every weekday morning.">
  <div class="wrap narrow">
    <NewsletterSignup variant="banner" />
    <div class="prose perks">
      <h2>What you'll get</h2>
      <ul>
        <li>The day's headlines from Bristol County newsrooms, police and town halls.</li>
        <li>Public meetings and agendas coming up in your town.</li>
        <li>Links straight to the original reporting.</li>
      </ul>
      <p class="meta">Free. Unsubscribe any time. We never sell your email address.</p>
    </div>
  </div>
</Base>

<style>
  .narrow { max-width: 760px; padding-top: 40px; }
  .perks { margin: 32px auto 0; }
</style>
