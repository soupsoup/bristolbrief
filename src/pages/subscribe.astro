---
import Base from '../layouts/Base.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
---
<Base title="Subscribe" description="Get the week's Bristol County news in your inbox, free, once a week.">
  <div class="wrap narrow">
    <NewsletterSignup variant="banner" />
    <div class="prose perks">
      <h2>What you'll get</h2>
      <ul>
        <li>The week's top headlines from Bristol County newsrooms, police and town halls.</li>
        <li>Public meetings and agendas coming up in your town.</li>
        <li>Links straight to the original reporting.</li>
      </ul>
      <p class="meta">Free, once a week. Unsubscribe any time. We never sell your email address.</p>
    </div>
  </div>
</Base>

<style>
  .narrow { max-width: 760px; padding-top: 40px; }
  .perks { margin: 32px auto 0; }
</style>
