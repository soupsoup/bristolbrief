---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
import DiscordIcon from '../components/DiscordIcon.astro';
---
<Base title="Send a tip" description="Tell The Bristol Brief what we should be covering.">
  <div class="wrap">
    <p class="kicker" style="margin:32px 0 0">Tips</p>
    <h1 class="page-title" style="margin-top:4px">What should we be covering?</h1>
    <div class="prose">
      <p>
        You know your neighborhood better than we do. Tell us about the new restaurant going in on
        your corner, the agenda item nobody's talking about, or a local news source we should be following.
      </p>
      <p class="tip-actions">
        <a class="btn" href={`mailto:${SITE.email}?subject=News%20tip`}>Email {SITE.email}</a>
        <a class="btn btn-discord" href={SITE.social.discord} target="_blank" rel="noopener"><DiscordIcon /> Share it on Discord</a>
      </p>
      <p class="meta">
        Our Discord is a public community space, so anyone there can read what you post. Send anything
        sensitive or confidential by email instead.
      </p>
      <h2>Helpful details to include</h2>
      <ul>
        <li>Which town, and where (street or business name).</li>
        <li>When it happened or will happen.</li>
        <li>How you know, plus any documents, photos or links.</li>
        <li>How we can reach you if we have follow-up questions.</li>
      </ul>
      <p class="meta">
        We read every tip. We won't publish your name without your permission.
      </p>
    </div>
  </div>
</Base>

<style>
  .tip-actions { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
