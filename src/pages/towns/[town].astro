---
import Base from '../../layouts/Base.astro';
import StoryIndex from '../../components/StoryIndex.astro';
import EventList from '../../components/EventList.astro';
import { getStories, getUpcomingEvents } from '../../lib/content';
import { TOWNS } from '../../site.config';

export function getStaticPaths() {
  return TOWNS.map((t) => ({ params: { town: t.slug }, props: { name: t.name } }));
}

const { town } = Astro.params;
const { name } = Astro.props;
const stories = (await getStories()).filter((s) => s.data.towns.includes(town));
const events = (await getUpcomingEvents()).filter((e) => e.data.town === town).slice(0, 5);
---
<Base title={name} description={`News, events and things to do in ${name}, Massachusetts.`}>
  <StoryIndex
    kicker="Bristol County"
    title={name}
    dek={`The latest news and events from ${name}.`}
    stories={stories}
  >
    <div slot="rail">
      <div class="section-head"><h2>Upcoming in {name}</h2></div>
      <EventList events={events} compact />
    </div>
  </StoryIndex>
</Base>
