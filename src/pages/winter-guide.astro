---
import Base from '../layouts/Base.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import guide from '../data/winter-guide.json';
import { townName } from '../site.config';

type Town = {
  town: string;
  kind: 'seasonal' | 'storm' | 'both';
  headline: string;
  rules: string[];
  sources: { label: string; url: string }[];
};
const towns = (guide.towns as Town[]).slice().sort((a, b) => townName(a.town).localeCompare(townName(b.town)));
const checked = new Date(`${guide.checked}T12:00:00Z`).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' });
const KIND: Record<Town['kind'], string> = {
  seasonal: 'Rules all winter',
  storm: 'Bans storm by storm',
  both: 'All winter + storm bans',
};
const allWinter = towns.filter((t) => t.kind !== 'storm').map((t) => townName(t.town));
---
<Base
  title="Winter parking guide: snow bans in all 20 Bristol County towns"
  description="Where you can park when it snows in each of Bristol County's 20 cities and towns: overnight winter bans, storm parking bans, hydrant-side rules and free lots, from each town's own rules."
>
  <div class="wrap narrow">
    <p class="kicker" style="margin:32px 0 0">Winter guide</p>
    <h1 class="page-title" style="margin-top:4px">Where you can park when it snows</h1>
    <p class="page-dek">
      Snow parking rules for all 20 Bristol County cities and towns, from each town's own bylaws and notices.
      Some towns ban overnight street parking all winter; most declare bans storm by storm.
    </p>
    <p class="meta">Checked {checked}. Rules change, and a town's own announcement always wins. See something out of date? <a href="/tips/">Tell us</a>.</p>

    <section class="quick" aria-labelledby="quick-title">
      <h2 id="quick-title">The short version</h2>
      <ul>
        <li><strong>Rules that apply all winter, snow or not:</strong> {allWinter.join(', ')}.</li>
        <li><strong>Everywhere else:</strong> watch for a declared ban before each storm, and keep cars off the street while plows run. Cars that block plows can be towed in every town.</li>
        <li><strong>Hydrants and corners:</strong> never park within 10 feet of a hydrant or 20 feet of a corner, ban or not.</li>
      </ul>
    </section>

    <nav class="town-jump" aria-label="Jump to a town">
      {towns.map((t) => <a href={`#${t.town}`}>{townName(t.town)}</a>)}
    </nav>

    <div class="towns">
      {towns.map((t) => (
        <section class="town" id={t.town} aria-labelledby={`${t.town}-name`}>
          <p class={`badge badge-${t.kind}`}>{KIND[t.kind]}</p>
          <h2 id={`${t.town}-name`}><a href={`/towns/${t.town}/`}>{townName(t.town)}</a></h2>
          <p class="town-headline">{t.headline}</p>
          <ul>{t.rules.map((r) => <li>{r}</li>)}</ul>
          <p class="meta">Source: {t.sources.map((s, i) => (<><a href={s.url} target="_blank" rel="noopener">{s.label}</a>{i < t.sources.length - 1 ? '; ' : ''}</>))}</p>
        </section>
      ))}
    </div>

    <div style="margin:40px 0">
      <NewsletterSignup />
    </div>
  </div>
</Base>

<style>
  .narrow { max-width: 820px; }
  .quick { background: var(--paper-2); border-top: 3px solid var(--accent); padding: 16px 20px; margin: 24px 0; }
  .quick h2 { font-family: var(--serif-display); font-size: 22px; margin: 0 0 8px; }
  .quick ul { margin: 0; padding-left: 20px; }
  .quick li { margin: 6px 0; }
  .town-jump { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0 0 24px; font-family: var(--sans); font-size: 14px; }
  .town { border-top: 1px solid var(--rule); padding: 18px 0 8px; scroll-margin-top: 80px; }
  .town h2 { font-family: var(--serif-display); font-size: 24px; margin: 2px 0 2px; }
  .town h2 a { color: inherit; text-decoration: none; }
  .town-headline { margin: 0 0 8px; font-weight: 600; }
  .town ul { margin: 0 0 8px; padding-left: 20px; }
  .town li { margin: 4px 0; }
  .badge { display: inline-block; margin: 0; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-2); }
  .badge-seasonal, .badge-both { color: var(--accent); }
</style>
